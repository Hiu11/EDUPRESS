APP_NAME=EduPress API
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
CLIENT_ORIGIN=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=3
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_STREAM_PER_MINUTE=20
MAX_PROMPT_HISTORY_ITEMS=40
MAX_UPLOAD_BYTES=10485760
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/edupress_write
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=1440
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://admin:adminpassword@localhost:27017/?authSource=admin
MODAL_WHISPER_URL=
